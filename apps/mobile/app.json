{
  "expo": {
    "name": "Wingman",
    "slug": "wingman",
    "scheme": "wingman",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "entitlements": {
        "aps-environment": "development"
      },
      "bundleIdentifier": "com.wingman.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e0c12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wingman.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wingman uses your photo library so you can pick the photo your match will see.",
          "cameraPermission": "Wingman uses the camera so you can take the photo your match will see."
        }
      ],
      "expo-notifications"
    ]
  }
}
