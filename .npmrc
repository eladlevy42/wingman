# pnpm names each virtual-store directory after the package and its full peer
# set, which routinely runs past 100 characters (vitest's is 116). Combined with
# this repo's worktree-per-branch workflow — the worktree is named after the
# issue slug, so paths are long before node_modules is even reached — the
# resulting paths cross the 260-character Windows MAX_PATH limit and Node simply
# cannot resolve the package. It surfaces as a bogus
# "Cannot find package '.../picomatch/package.json'" from a dependency that is
# demonstrably on disk.
#
# Truncating the directory names to 60 characters (pnpm appends a hash, so they
# stay unique) keeps those paths inside the limit. No effect on Linux CI beyond
# shorter directory names.
virtual-store-dir-max-length=60
